// ---- Paramètres de la goutte ----
drop_rad = 10;     // Rayon de la goutte
drop_x = -273.0;     // Position X (à ajuster selon tes besoins)
drop_y = 6.0;        // Position Y
lc_drop = lc * 0.5;  // Maillage plus fin pour la goutte

// ---- Points de la goutte ----
Point(170) = {drop_x, drop_y, 0, lc_drop};             // Centre
Point(171) = {drop_x + drop_rad, drop_y, 0, lc_drop};   // Est
Point(172) = {drop_x, drop_y + drop_rad, 0, lc_drop};   // Nord
Point(173) = {drop_x - drop_rad, drop_y, 0, lc_drop};   // Ouest
Point(174) = {drop_x, drop_y - drop_rad, 0, lc_drop};   // Sud

