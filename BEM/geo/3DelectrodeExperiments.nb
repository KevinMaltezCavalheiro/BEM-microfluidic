     RowBox[{"(", 
      RowBox[{"Tensions", " ", "de", " ", "fusion"}], ")"}], " ", "par", " ", 
     "r\[EAcute]plicat"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"centerStats", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Query", "[", 
       RowBox[{
        RowBox[{"GroupBy", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#Coverslip", ",", "#Replicate"}], "}"}], "&"}], "]"}], ",", 
